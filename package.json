{
  "name": "uruka-is-klik",
  "displayName": "Urukais KLick",
  "description": "Autocompletado y edición de código con MiniCPM5-2B local (CPU/llama.cpp).",
  "version": "0.1.0",
  "publisher": "urukaisk-maker",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/urukaisk-maker/uruka-is-klik.git"
  },
  "bugs": {
    "url": "https://github.com/urukaisk-maker/uruka-is-klik/issues"
  },
  "homepage": "https://github.com/urukaisk-maker/uruka-is-klik#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["AI", "Programming Languages", "Machine Learning"],
  "keywords": ["copilot", "local", "minicpm", "autocomplete", "code", "llama.cpp"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "uruka-is-klik.explain", "title": "Urukais: Explicar selección" },
      { "command": "uruka-is-klik.refactor", "title": "Urukais: Refactorizar selección" },
      { "command": "uruka-is-klik.fix", "title": "Urukais: Corregir error" },
      { "command": "uruka-is-klik.openChat", "title": "Urukais: Abrir chat" }
    ],
    "configuration": {
      "title": "Urukais KLick",
      "properties": {
        "uruka-is-klik.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080/v1",
          "description": "URL del servidor llama.cpp (OpenAI-compatible)."
        },
        "uruka-is-klik.model": {
          "type": "string",
          "default": "MiniCPM5-1B",
          "description": "ID del modelo. Debe coincidir con el nombre que anuncia llama-server."
        },
        "uruka-is-klik.apiKey": {
          "type": "string",
          "default": "EMPTY",
          "description": "API key (usa EMPTY en local)."
        },
        "uruka-is-klik.inlineCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Activar autocompletado inline (ghost text)."
        },
        "uruka-is-klik.inlineCompletion.debounceMs": {
          "type": "number",
          "default": 500,
          "description": "Debounce en ms antes de solicitar completado."
        },
        "uruka-is-klik.inlineCompletion.maxTokens": {
          "type": "number",
          "default": 96,
          "description": "Máximo de tokens a generar por completado (bajo = rápido en CPU)."
        },
        "uruka-is-klik.inlineCompletion.temperature": {
          "type": "number",
          "default": 1.0,
          "description": "Temperatura de muestreo."
        },
        "uruka-is-klik.inlineCompletion.topP": {
          "type": "number",
          "default": 0.95,
          "description": "top_p para muestreo."
        },
        "uruka-is-klik.inlineCompletion.minP": {
          "type": "number",
          "default": 0.0,
          "description": "min_p. IMPORTANTE: 0.0 para evitar repeticiones en llama.cpp."
        },
        "uruka-is-klik.inlineCompletion.repetitionPenalty": {
          "type": "number",
          "default": 1.05,
          "description": "Penalización por repetición."
        }
      }
    },
    "keybindings": [
      {
        "command": "uruka-is-klik.openChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "openai": "^4.70.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^2.30.0"
  }
}
